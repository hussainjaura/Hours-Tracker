# Database Connection (REQUIRED)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT Authentication Secret (REQUIRED)
# Generate a strong random string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Configuration
API_VERSION=1.0.0
NODE_ENV=development

# Server Configuration
# Port will be set automatically by cloud platforms (Heroku, Railway, etc.)
# Only set this if running locally
PORT=4000

# Frontend URL (REQUIRED for CORS):
# For multiple origins, use comma-separated values: http://localhost:3000,https://app.example.com
FRONTEND_URL=http://localhost:3000

# Email Verification (Optional)
# Set to 'true' to enable email verification for new registrations
ENABLE_EMAIL_VERIFICATION=false

# Reverse proxy (set when hosted, e.g. TRUST_PROXY=1 on Render/Railway/Heroku)
# Makes rate limiting and audit logs see each visitor's real IP address.
# Leave unset for local development.
# TRUST_PROXY=1

# Email (password reset links). Uses https://resend.com
# Without these, emails are only printed in the server console.
# EMAIL_FROM's domain must be verified in your Resend account.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=ISC Audit <no-reply@yourdomain.com>

# Admin account (Optional)
# The seed only creates an admin when both are set. Never commit a real password.
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=choose-a-strong-password
