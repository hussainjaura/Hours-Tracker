generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  lastLogin DateTime? // Track last login time

  student            Student?
  employer           Employer?
  passwordResetTokens PasswordResetToken[]
}

model University {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique // e.g. "SOUTHAMPTON"
  createdAt DateTime @default(now())

  templates TermTemplate[]
}

model Student {
  id             Int      @id @default(autoincrement())
  userId         String   @unique
  fullName       String
  universityId   String   @unique
  universityName String?  // Made nullable to handle existing records
  visaType       String
  courseEndDate  DateTime
  maxWeeklyHours Int?
  createdAt      DateTime @default(now())

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms         Term[]
  workShifts    WorkShift[]
  employerLinks StudentEmployer[]
  violations    ComplianceViolation[]
}

model TermTemplate {
  id           Int      @id @default(autoincrement())
  universityId Int
  name         String // AUTUMN, SPRING, SUMMER
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

enum CourseLevel {
  BELOW_DEGREE      // 10 hours/week during term-time
  DEGREE_OR_ABOVE   // 20 hours/week during term-time
}

model Term {
  id           Int      @id @default(autoincrement())
  studentId    Int
  courseLevel  CourseLevel? // Course level determines work hour limits
  name         String // "AUTUMN", "SPRING", "SUMMER"
  academicYear String? // e.g., "2025/26", "2026/27" (optional for backward compatibility)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())

  // Student confirmation (compliance requirement)
  confirmedAt DateTime? // When student confirmed these term dates
  confirmedBy String? // Student user ID who confirmed

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, academicYear, name])
}

enum TermType {
  AUTUMN
  SPRING
  SUMMER
}

enum ShiftStatus {
  PENDING // Awaiting student confirmation
  CONFIRMED // Student confirmed
  REJECTED // Student rejected
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum EmployerRole {
  MANAGER
  HR
  OWNER
}

model Employer {
  id              Int          @id @default(autoincrement())
  userId          String       @unique
  fullName        String
  workEmail       String
  role            EmployerRole
  organisationName String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  // Login tracking
  lastLogin       DateTime?
  lastLoginIp     String?
  lastLoginUserAgent String?
  
  // IP addresses for acknowledgements (stored as JSON array)
  acknowledgementIps Json? // Array of IP addresses used for acknowledgements
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model StudentEmployer {
  id         Int                @id @default(autoincrement())
  studentId  Int
  employerId String // User ID of employer
  status     RelationshipStatus @default(PENDING)
  linkedAt   DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Employer acknowledgement (compliance requirement)
  acknowledgedAt DateTime? // When employer acknowledged student's declarations
  acknowledgedBy String? // Employer user ID who acknowledged

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, employerId])
  @@index([employerId])
  @@index([studentId])
}

model WorkShift {
  id          Int         @id @default(autoincrement())
  studentId   Int
  employerId  String // User ID of employer
  date        DateTime
  hours       Decimal     @db.Decimal(4, 2) // e.g., 8.50 hours
  description String?
  status      ShiftStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violations ComplianceViolation[]

  @@index([studentId, date])
  @@index([date])
  @@index([employerId])
  @@index([status])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  entityType   String
  entityId     Int
  performedBy  String
  universityId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Enhanced audit fields for compliance
  ipAddress           String? // IP address of the user performing the action
  userAgent           String? // User agent/browser information
  declarationText     String? // Student declaration text (Layer 2)
  acknowledgementText String? // Employer acknowledgement text (Layer 3)
  complianceRule      Json? // System-generated compliance rule (Layer 4)
  changeHistory       Json? // Previous vs new values for change tracking (Layer 5)

  @@index([performedBy])
  @@index([universityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

enum ViolationType {
  WEEKLY_LIMIT_EXCEEDED // Student worked more than allowed hours in a week
  COURSE_ENDED // Student worked after course end date
  TERM_LIMIT_EXCEEDED // Student worked more than term-time limit during term
  INVALID_SHIFT_CONFIRMED // Shift was confirmed that violated rules
}

enum ViolationSeverity {
  LOW // Minor violation, warning only
  MEDIUM // Moderate violation, requires attention
  HIGH // Serious violation, may affect visa status
  CRITICAL // Critical violation, immediate action required
}

model ComplianceViolation {
  id            Int               @id @default(autoincrement())
  studentId     Int
  employerId    String? // Null if violation not tied to specific employer
  workShiftId   Int? // Null if violation not tied to specific shift
  violationType ViolationType
  severity      ViolationSeverity @default(MEDIUM)

  // Violation details
  weekStart    DateTime // Start of the week when violation occurred
  weekEnd      DateTime // End of the week when violation occurred
  allowedHours Decimal  @db.Decimal(5, 2) // e.g., 20.00 or 40.00
  actualHours  Decimal  @db.Decimal(5, 2) // Hours actually worked
  excessHours  Decimal  @db.Decimal(5, 2) // How many hours over limit

  // Context
  inTermTime     Boolean   @default(false)
  activeTermName String?
  courseEndDate  DateTime?

  // Responsibility tracking
  causedBy    String // "STUDENT", "EMPLOYER", or "SYSTEM"
  description String? // Human-readable description

  // Metadata
  metadata  Json? // Additional context (eligibility check, limit check, etc.)
  createdAt DateTime @default(now())

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workShift WorkShift? @relation(fields: [workShiftId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([employerId])
  @@index([workShiftId])
  @@index([violationType])
  @@index([severity])
  @@index([weekStart])
  @@index([createdAt])
}
